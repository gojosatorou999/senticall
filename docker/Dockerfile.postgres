# PostGIS + pgvector on Postgres 16.
#
# Real deployment runs a single RDS PG16 instance with both extensions
# installed (spec §12.1). Locally we bake the same combination into one
# image so `make dev` reflects production.
FROM postgis/postgis:16-3.4

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-16-pgvector \
    && rm -rf /var/lib/apt/lists/*
