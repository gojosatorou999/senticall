# Sentinel Voice Agent — environment template.
# Copy to .env and fill in. src/fg_voice/config.py fails at boot on missing
# required vars, so an incomplete .env is caught immediately, not at runtime.

# ── Runtime ───────────────────────────────────────────────────
FG_ENV=dev                          # dev | staging | production
FG_AGENT_VERSION=dev-local          # injected at build time in CI
FG_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
FG_REGION=ap-south-1

# ── Telephony (Twilio) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MEDIA_REGION=sg1
PUBLIC_WSS_BASE=wss://voice.sentinel.in
TELEPHONY_PROVIDER=twilio           # twilio | exotel

# ── STT (Deepgram Flux) ──────────────────────────────────────
DEEPGRAM_API_KEY=
STT_MODEL=flux-general-en
STT_FALLBACK_MODEL=nova-3
STT_EOT_THRESHOLD=0.7
STT_EAGER_EOT_THRESHOLD=0.55
STT_EOT_TIMEOUT_MS=1200

# ── TTS ──────────────────────────────────────────────────────
TTS_PROVIDER=cartesia               # cartesia | deepgram | polly
TTS_API_KEY=
TTS_VOICE_ID=
TTS_CACHE_TTL_SEC=604800
AUDIO_BANK_PATH=/app/prompts/audio_bank/en-IN

# ── LLM (slot extraction) ────────────────────────────────────
LLM_PROVIDER=bedrock                # bedrock | anthropic
BEDROCK_REGION=ap-south-1
LLM_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
LLM_FALLBACK_API_KEY=               # direct Anthropic API failover
LLM_TIMEOUT_MS=800
LLM_MAX_TOKENS=100

# ── Noise suppression ────────────────────────────────────────
DENOISE_PROVIDER=rnnoise            # krisp | rnnoise | none
KRISP_LICENSE_KEY=

# ── Data ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fg_voice:fg_voice@localhost:55432/fg_voice
REDIS_URL=redis://localhost:56379/0
CALLER_HASH_PEPPER=dev-only-do-not-use-in-prod
S3_RECORDINGS_BUCKET=fg-voice-recordings
S3_TRANSCRIPTS_BUCKET=fg-voice-transcripts
S3_REPORTS_BUCKET=fg-reports
S3_RAG_BUCKET=fg-voice-rag
EFS_CSV_PATH=./data/csv
CSV_SCHEMA_VERSION=1

# ── AWS (local dev uses localstack) ──────────────────────────
AWS_ENDPOINT_URL=http://localhost:54566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1

# ── RAG ──────────────────────────────────────────────────────
GAZETTEER_SNAPSHOT_VERSION=latest
TAXONOMY_VERSION=latest
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GEO_ACCEPT_THRESHOLD=0.85
GEO_CONFIRM_THRESHOLD=0.60
GEO_MARGIN_THRESHOLD=0.10

# ── Conversation ─────────────────────────────────────────────
MAX_CALL_DURATION_SEC=300
NO_INPUT_TIMEOUT_MS=6000
MAX_ATTEMPTS_PER_SLOT=3
EMERGENCY_NUMBER=112

# ── Ops ──────────────────────────────────────────────────────
ALERT_SNS_TOPIC_ARN=
OTEL_EXPORTER_OTLP_ENDPOINT=
SURGE_MODE_MIN_TASKS=10
